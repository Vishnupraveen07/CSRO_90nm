	 -design_cell_name "csro layout CSRO" \
	 -run_name "csro" \
	 -directory_name "/home/vlsilab/CSRO_PVG" \
	 -format "DFII" \
	 -library_definitions_file "/home/vlsilab/CSRO_PVG/cds.lib"
